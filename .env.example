# ============================================================
# POC Demo — Environment Variables
# Copy this file to .env and fill in the values.
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=poc_demo
POSTGRES_USER=poc
POSTGRES_PASSWORD=changeme          # REQUIRED: set a strong password

# --- JWT Authentication ---
JWT_SECRET_KEY=changeme             # REQUIRED: random string (e.g. openssl rand -hex 32)
JWT_EXPIRE_MINUTES=480              # Token lifetime in minutes (default 8 hours)

# --- API Key Encryption (Fernet) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=changeme             # REQUIRED: Fernet key for encrypting stored API keys

# --- CORS ---
# Comma-separated origins, leave empty for localhost defaults
CORS_ORIGINS=

# --- Logging ---
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT=120/minute       # Global default per IP

# --- Docker ---
DOCKER_GID=999                      # Host docker group GID (run: getent group docker | cut -d: -f3)

# --- Frontend ---
FRONTEND_PORT=5175                  # Port exposed to host
