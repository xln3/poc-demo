# ============================================================
# POC Demo — Environment Variables
# Copy this file to .env and fill in the values.
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=poc_demo
POSTGRES_USER=poc
POSTGRES_PASSWORD=                      # REQUIRED: set a strong password

# --- JWT Authentication ---
JWT_SECRET_KEY=                         # REQUIRED: random string (openssl rand -hex 32)
JWT_EXPIRE_MINUTES=480                  # Token lifetime in minutes (default 8 hours)

# --- API Key Encryption (Fernet) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=                         # REQUIRED: Fernet key for encrypting stored API keys

# --- CORS ---
CORS_ORIGINS=                           # Comma-separated origins, leave empty for localhost defaults

# --- Logging ---
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT=120/minute           # Global default per IP

# --- Docker ---
DOCKER_GID=999                          # Host docker group GID (run: getent group docker | cut -d: -f3)

# --- Frontend ---
FRONTEND_PORT=5175                      # Port exposed to host

# --- LLM Providers ---
OPENAI_API_KEY=                         # OpenAI-compatible API key (e.g. aihubmix)
OPENAI_BASE_URL=https://aihubmix.com/v1

ZHIPU_API_KEY=                          # ZhipuAI GLM API key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
