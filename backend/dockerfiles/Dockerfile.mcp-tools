# MCP Tools Container - 用于文件解析、RAG 向量存储和工具执行
# 包含所有MCP解析器依赖，支持PDF、DOCX、XLSX、图片等格式
# 包含 ChromaDB 向量数据库

FROM python:3.11-slim

# 设置工作目录
WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Tesseract OCR 引擎
    tesseract-ocr \
    tesseract-ocr-chi-sim \
    tesseract-ocr-eng \
    # PDF 图像转换依赖
    poppler-utils \
    # 图片处理依赖
    libimage-exiftool-perl \
    # 编译依赖（chromadb 需要）
    build-essential \
    # 常用工具
    curl \
    wget \
    git \
    vim \
    && rm -rf /var/lib/apt/lists/*

# 安装Python依赖
RUN pip install --no-cache-dir \
    # PDF解析
    PyMuPDF>=1.24.0 \
    pdfplumber>=0.10.0 \
    pdf2image>=1.16.0 \
    pytesseract>=0.3.10 \
    # DOCX解析
    python-docx>=1.1.0 \
    mammoth>=1.6.0 \
    # XLSX解析
    openpyxl>=3.1.0 \
    # 图片处理
    Pillow>=10.0.0 \
    # RAG 向量数据库
    chromadb>=0.4.0

# 复制MCP解析器模块和CLI入口
COPY app/services/mcp_parsers.py /app/mcp_parsers.py
COPY app/services/mcp_parser_cli.py /app/mcp_parser_cli.py

# 复制RAG CLI
COPY app/services/rag_cli.py /app/rag_cli.py

# 复制预置数据（从 public/attack-samples/rag/ 目录）
# 注意：构建时需要从 backend 目录执行，预置数据需要单独复制
COPY docker/preset-data/ /app/preset-data/

# 创建数据目录
RUN mkdir -p /data/chromadb

# 验证安装
RUN tesseract --version && \
    python3 -c "import fitz; import pdfplumber; import pytesseract; import chromadb; print('✓ All dependencies installed')"

# 暴露工作目录和数据目录
VOLUME /workspace
VOLUME /data

# 默认命令
CMD ["/bin/bash"]
