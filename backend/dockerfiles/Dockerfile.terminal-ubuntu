# Terminal Sandbox - Ubuntu 22.04
#
# 职责:
#   - 提供完整的Linux环境用于终端执行
#   - 支持上传/下载文件和目录
#   - 支持运行各种Linux命令和脚本
#   - 提供完整的开发工具链（gcc, make, python等）
#
# 不包含:
#   - ❌ OCR工具（Tesseract等）
#   - ❌ ChromaDB
#   - ❌ 数据库服务器（仅客户端工具）
#
# 资源限制: 内存 2GB, CPU 50%
# 生命周期: 手动管理，单例模式
# Session ID: 基于用户tag生成（如 "terminal-ubuntu-test1"）
#
# 构建命令: docker build -f dockerfiles/Dockerfile.terminal-ubuntu -t terminal-ubuntu:22.04 .

FROM ubuntu:22.04

# 避免交互式提示
ENV DEBIAN_FRONTEND=noninteractive

# 设置工作目录
WORKDIR /workspace

# 安装基础系统工具和开发环境
RUN apt-get update && apt-get install -y --no-install-recommends \
    # 核心工具
    ca-certificates \
    curl \
    wget \
    # 版本控制
    git \
    # 文本编辑器
    vim \
    nano \
    # 压缩工具
    zip \
    unzip \
    tar \
    gzip \
    bzip2 \
    # Python环境
    python3 \
    python3-pip \
    python3-venv \
    # 编译工具
    gcc \
    g++ \
    make \
    # 进程管理和监控
    procps \
    htop \
    # 网络工具
    net-tools \
    iputils-ping \
    netcat \
    # 文件管理
    tree \
    less \
    file \
    # 文件监控
    inotify-tools \
    # 其他常用工具
    jq \
    && rm -rf /var/lib/apt/lists/*

# 创建python3的软链接为python
RUN ln -s /usr/bin/python3 /usr/bin/python

# 安装常用Python库
RUN pip3 install --no-cache-dir \
    requests \
    beautifulsoup4 \
    python-dotenv

# 创建工作目录
RUN mkdir -p /workspace

# 验证安装
RUN python --version && \
    gcc --version && \
    git --version && \
    echo "✓ Ubuntu environment ready"

# 暴露工作目录
VOLUME /workspace

# 保持容器运行
CMD ["tail", "-f", "/dev/null"]
