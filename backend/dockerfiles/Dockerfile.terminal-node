# Terminal Sandbox - Node.js 20
#
# 职责:
#   - 为智能体提供隔离的Node.js终端执行环境
#   - 支持上传/下载文件和目录
#   - 支持运行JavaScript/TypeScript代码和npm命令
#   - 提供常用npm包和Linux工具
#
# 不包含:
#   - ❌ OCR工具（Tesseract等）
#   - ❌ ChromaDB
#   - ❌ 数据库客户端
#
# 资源限制: 内存 2GB, CPU 50%
# 生命周期: 手动管理，单例模式
# Session ID: 基于用户tag生成（如 "terminal-node-test1"）
#
# 构建命令: docker build -f dockerfiles/Dockerfile.terminal-node -t terminal-node:20 .

FROM node:20-slim

# 设置工作目录
WORKDIR /workspace

# 安装基础Linux工具
RUN apt-get update && apt-get install -y --no-install-recommends \
    # 网络工具
    curl \
    wget \
    # 版本控制
    git \
    # 文本编辑器
    vim \
    nano \
    # 压缩工具
    zip \
    unzip \
    # 进程管理
    procps \
    # 文件监控
    inotify-tools \
    # 其他常用工具
    tree \
    less \
    && rm -rf /var/lib/apt/lists/*

# 安装常用npm包（全局）
RUN npm install -g \
    # HTTP客户端
    axios \
    # 实用工具
    lodash \
    # 日期处理
    dayjs \
    # 环境变量
    dotenv \
    # TypeScript
    typescript \
    ts-node \
    # 代码格式化
    prettier \
    # 测试框架
    jest

# 创建工作目录
RUN mkdir -p /workspace

# 验证安装
RUN node --version && \
    npm --version && \
    tsc --version && \
    echo "✓ Node.js environment ready"

# 暴露工作目录
VOLUME /workspace

# 保持容器运行
CMD ["tail", "-f", "/dev/null"]
