# Terminal Sandbox - Python 3.11
#
# 职责:
#   - 为智能体提供隔离的Python终端执行环境
#   - 支持上传/下载文件和目录
#   - 支持运行Python代码和shell命令
#   - 提供常用Python库和Linux工具
#
# 不包含:
#   - ❌ OCR工具（Tesseract等）
#   - ❌ ChromaDB
#   - ❌ 数据库客户端
#
# 资源限制: 内存 2GB, CPU 50%
# 生命周期: 手动管理，单例模式（同一时刻只允许一个终端容器）
# Session ID: 基于用户tag生成（如 "terminal-python-test1"）
#
# 构建命令: docker build -f dockerfiles/Dockerfile.terminal-python -t terminal-python:3.11 .

FROM python:3.11-slim

# 设置工作目录
WORKDIR /workspace

# 安装基础Linux工具（无OCR、无数据库）
RUN apt-get update && apt-get install -y --no-install-recommends \
    # 网络工具
    curl \
    wget \
    # 版本控制
    git \
    # 文本编辑器
    vim \
    nano \
    # 压缩工具
    zip \
    unzip \
    tar \
    # 进程管理
    procps \
    # 文件监控
    inotify-tools \
    # 其他常用工具
    tree \
    less \
    && rm -rf /var/lib/apt/lists/*

# 安装常用Python库
# 注意：版本约束必须用引号包裹，否则 shell 会将 > 解释为重定向
RUN pip install --no-cache-dir \
    "requests>=2.31.0" \
    "beautifulsoup4>=4.12.0" \
    "lxml>=4.9.0" \
    "pandas>=2.1.0" \
    "numpy>=1.26.0" \
    "python-dateutil>=2.8.0" \
    "pydantic>=2.5.0" \
    "python-dotenv>=1.0.0"

# 创建工作目录
RUN mkdir -p /workspace

# 验证安装
RUN python3 --version && \
    python3 -c "import requests; import pandas; import numpy; print('✓ Python environment ready')"

# 暴露工作目录
VOLUME /workspace

# 保持容器运行
CMD ["tail", "-f", "/dev/null"]
